# Build artifacts, except the JAR used by Dockerfile.fast.
**/build/
!service/build/
!service/build/libs/
!service/build/libs/*.jar
.gradle/
.kotlin/

# Repository and IDE metadata.
.git/
.gitignore
.idea/
*.iml

# Local/reference projects that are not needed in the image context.
auction/

